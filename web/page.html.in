<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{TITLE}}</title>
<style>
  html, body { margin: 0; height: 100%; background: {{BG}}; color: {{FG}};
               font: 15px/1.5 system-ui, sans-serif; overflow: hidden; }
  #game { position: fixed; inset: 0; }
  canvas { display: block; width: 100%; height: 100%; outline: none; }
  #status { position: fixed; inset: 0; display: grid; place-items: center; text-align: center;
            padding: 0 16px; pointer-events: none; }
  #status[hidden] { display: none; }
  #status small { color: {{DIM}}; }
</style>
</head>
<body>
<div id="game"><canvas id="{{GAME}}" tabindex="0"></canvas></div>
<div id="status"><div>{{TITLE}}<br><small id="step">loading the Ruby compiler…</small></div></div>
<script type="module">
// Two modules: the game (Bevy + the SabiRuby VM, wasm32-unknown-unknown) and the Ruby compiler
// (the reference mruby compiler in C, the SabiRuby playground's wasm32-wasip1 module). The game
{{COMPILE_NOTE}}
import { Sabi, OK } from "./compiler/sabi.js";

const status = document.getElementById("status");
const step = document.getElementById("step");

{{KEYS_NOTE}}
addEventListener("keydown", (e) => {
  const mod = e.ctrlKey || e.metaKey;
  const own = [{{KEYS}}].includes(e.key);
  if (own || (mod && (e.key === "s" || e.key === "Enter"))) e.preventDefault();
}, { capture: true });

try {
  const sabi = await Sabi.create(await fetch("./compiler/sabiruby.wasm"));
  window.{{GAME}}Compile = (source) => {
    if (sabi.compile(source, true) !== OK) throw sabi.text();
    return sabi.binary();
  };
  // The editor's colours (H2). One kind per source byte, 0..8, from the same module's Prism —
  // the game asks once per edit, not once per frame, and a build of the game older than this
  // page simply never calls it. It must not throw: the panel is drawn every frame and an
  // exception crossing back into wasm here would take the canvas with it.
  window.{{GAME}}Highlight = (source) => {
    try { return sabi.highlight(source); } catch (e) { console.error(e); return new Uint8Array(0); }
  };
  step.textContent = "loading the game…";
  const game = await import("./pkg/game.js");
  setTimeout(() => { status.hidden = true; document.getElementById("{{GAME}}").focus(); }, 0);
  await game.default();
} catch (e) {
  // winit leaves its start-up by throwing on purpose; that one is not a failure
  if (!String(e).includes("Using exceptions for control flow")) {
    status.hidden = false;
    step.textContent = "could not start: " + e;
    console.error(e);
  }
}
</script>
</body>
</html>
